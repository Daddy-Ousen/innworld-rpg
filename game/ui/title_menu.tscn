[node name="Continue" type="Button" parent="Center/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Continue"

[node name="Load" type="Button" parent="Center/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Load"

[node name="Quit" type="Button" parent="Center/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Quit"

[node name="Starts" type="VBoxContainer" parent="Center/VBox"]
unique_name_in_owner = true
visible = false
