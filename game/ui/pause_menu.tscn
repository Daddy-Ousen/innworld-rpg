[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://ui/pause_menu.gd" id="1_pause"]
[ext_resource type="PackedScene" path="res://ui/slot_list.tscn" id="2_slots"]

[node name="PauseMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
