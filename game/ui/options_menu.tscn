[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/options_menu.gd" id="1_options"]

[node name="OptionsMenu" type="PanelContainer"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -170.0
offset_top = -120.0
offset_right = 170.0
offset_bottom = 120.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_options")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 10

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.8, 1, 1)
horizontal_alignment = 1
text = "[Options]"

[node name="Rows" type="GridContainer" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
columns = 2

[node name="Mute" type="CheckBox" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Mute all sound"

[node name="LargeText" type="CheckBox" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Large text"

[node name="TouchRow" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2

[node name="TouchLabel" type="Label" parent="Margin/VBox/TouchRow"]
layout_mode = 2
text = "Touch controls"

[node name="Touch" type="OptionButton" parent="Margin/VBox/TouchRow"]
unique_name_in_owner = true
layout_mode = 2

[node name="Back" type="Button" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Back"
